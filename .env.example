# Copy thành .env rồi điền. KHÔNG commit file .env.

FRIGATE_API=http://frigate:5000/api
FRIGATE_RTSP=rtsp://frigate:8554

MQTT_HOST=mosquitto
MQTT_PORT=1883
# Broker có mật khẩu từ tuần 3. Tự đặt, giống nhau cho cả nhóm trên máy mình;
# docker compose tạo tài khoản này cho Mosquitto và đưa luôn cho Frigate.
# Module chạy ngoài Docker thì MQTT_HOST=127.0.0.1 (localhost ra IPv6, Docker chỉ mở IPv4).
MQTT_USER=safety
MQTT_PASS=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

INCIDENT_DB=data/incidents.db
SNAPSHOT_DIR=snapshots

# Docker Compose (Frigate) — xem docs/frigate-setup.md
# sim = chạy kèm camera giả lập rtsp-sim. Dùng camera thật thì để trống.
COMPOSE_PROFILES=sim
# Tài khoản camera IP thật, frigate/config.yml tham chiếu bằng {FRIGATE_CAM_USER}
FRIGATE_CAM_USER=
FRIGATE_CAM_PASS=
